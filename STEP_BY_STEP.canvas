		{"id":"f1f1cfd791db165a","type":"text","text":"# FRONT","x":-520,"y":-260,"width":160,"height":60},
		{"id":"1cd041e598891995","type":"text","text":"## Главный экран карточек","x":-980,"y":-139,"width":420,"height":60},
		{"id":"24c3525ba07adabf","type":"text","text":"## Экран авторизации","x":-920,"y":91,"width":360,"height":60},
		{"id":"0235919be0f9dac6","type":"text","text":"## Авторизация","x":720,"y":61,"width":226,"height":60},
		{"id":"62faaf16631b5cba","type":"text","text":"## Функционал замещения (вход под другим пользователем)","x":719,"y":175,"width":522,"height":130},
		{"id":"848c23e55dc7d775","type":"text","text":"## Логирование","x":725,"y":360,"width":250,"height":60},
		{"id":"262edb4b32e1ef6b","type":"text","text":"## Feature toogls","x":725,"y":480,"width":250,"height":50},
		{"id":"92aa1418fa23e2ac","type":"text","text":"## Экран карточки","x":-824,"y":-26,"width":264,"height":60},
		{"id":"763f21f5648d91a2","type":"text","text":"# Что?\n\nЭкран с карточками моделей\n   - Поиск по названию/категории\n   - Добавление в избранное\n   - Загрузка своих карточек\n   - Создание своей коллекции (добавление из общего пула)\n   - Количество лайков/загрузок/комментов\n\nЭкран карточки\n- Загрузка фото\n- Загрузка файлов для печати\n- Редактирование всего добра (как при первом добавлении так и последующем редактировании)\n- Количество лайков/загрузок, комменты\n\nЛК (личный кабинет)\n- Город пользователя\n- Ник\n- ФИО опционально\n- Способы связи\n- Выход на загруженные пользователем модели\n- Личные комменты\nНа перспективу - будет разделение по функционалу для ИП, дизайнеров, инженеров. Под ИП имею в виду всех, кто будет зарабатывать на печати","x":-1677,"y":-480,"width":555,"height":760},
		{"id":"e4a6ba9c855c1681","type":"text","text":"## Мульти языковая страница\nКак минимум этим функционалом могут пользоваться все, соответственно делаем на RUS/ENG\n\nЗаложить возможность на первых этапах\n","x":-900,"y":300,"width":340,"height":270},
		{"id":"90709652717a7bfc","type":"text","text":"## Темная/Светлая тема\nЯ бы начал с темной)","x":-924,"y":600,"width":364,"height":100},
		{"id":"0302b0de6a074ec5","type":"text","text":"## Подобрать/сделать библиотек компонентов","x":-920,"y":740,"width":360,"height":100},
		{"id":"7fc2fc2258262ec5","type":"text","text":"## Общий дизайн стайл\nИз пожеланий:\nВ сторону 3d, тематические значки, лоадеры и т.д, (см. референсы)\nЦветовая схема - ХЗ\nБольше всего мне нравится внешка printables","x":-880,"y":880,"width":320,"height":280},
		{"id":"10a721a0dce98052","type":"text","text":"# BACK","x":60,"y":-260,"width":140,"height":60},
		{"id":"28a9c8ea57e7a565","type":"text","text":"## Админ панель","x":-810,"y":180,"width":250,"height":60},
		{"id":"614f53da41e22f35","type":"text","text":"- JWT\n- Авторизация через сторонние сервисы","x":-120,"y":411,"width":250,"height":94},
		{"id":"f409bd4a2ee1a0a8","type":"text","text":"Управление из админки","x":-125,"y":570,"width":255,"height":60},
		{"id":"e6a3a47294a1c059","type":"text","text":"# Зачем?\n\nЭто база!\nНа этой сущности будет сторониться весь остальной функционал","x":200,"y":-800,"width":261,"height":180},
		{"id":"8beeaa29faf1bec4","type":"text","text":"## Модель данных\n[[SIMPLE_MODEL.canvas|SIMPLE_MODEL]]\n","x":740,"y":-310,"width":260,"height":100}
